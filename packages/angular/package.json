{
  "name": "@maayo/angular",
  "version": "0.3.0",
  "type": "module",
  "description": "Angular adapter for Maayo \u00e2\u20ac\u201d provideSync(), syncCollection() signal primitive",
  "keywords": [
    "offline-first",
    "sync",
    "angular",
    "signals"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@maayo/client": "workspace:*",
    "@maayo/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "dexie": ">=4.0.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "dexie": "^4.4.3",
    "typescript": "~5.8.3",
    "vitest": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
