{
  "name": "@maayo/protocol",
  "version": "0.3.1",
  "type": "module",
  "description": "Protocol types for the Maayo offline sync protocol",
  "keywords": [
    "offline-first",
    "sync",
    "protocol"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
