{
  "name": "@maayo/protocol",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/protocol/src",
  "projectType": "library",
  "tags": ["scope:protocol", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/protocol"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/protocol"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/protocol"
      }
    }
  }
}
