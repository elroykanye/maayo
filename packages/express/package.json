{
  "name": "@maayo/express",
  "version": "0.3.0",
  "type": "module",
  "description": "Express adapter for Maayo offline-first sync — maayoRouter() middleware",
  "keywords": ["offline-first", "sync", "express", "maayo"],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@maayo/protocol": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "express": "^4.21.2",
    "typescript": "~5.8.3",
    "vitest": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
