{
  "name": "@maayo/nest",
  "version": "0.3.1",
  "type": "module",
  "description": "NestJS adapter for Maayo offline-first sync — MaayoModule, MutationsController, ChangesController",
  "keywords": [
    "offline-first",
    "sync",
    "nestjs",
    "maayo"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@maayo/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.19",
    "@nestjs/core": "^10.4.19",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "typescript": "~5.8.3",
    "vitest": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
