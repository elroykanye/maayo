{
  "name": "@maayo/react",
  "version": "0.2.0",
  "description": "React adapter for Maayo \u00e2\u20ac\u201d SyncProvider, useCollection, useSyncStatus",
  "keywords": [
    "offline-first",
    "sync",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@maayo/client": "workspace:*",
    "@maayo/protocol": "workspace:*"
  },
  "peerDependencies": {
    "dexie": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "dexie": "^4.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}